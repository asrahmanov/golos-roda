# Локальная разработка (npm run dev). Скопируйте в .env и заполните.
DATABASE_URL=postgresql://svyaz:svyaz@localhost:55440/svyaz
AUTH_SECRET=замените-на-случайную-строку-не-короче-32-символов
STORAGE_DIR=./storage
NEXT_PUBLIC_SITE_URL=http://localhost:3010
COOKIE_SECURE=false

# Первый администратор создаётся при запуске сида, если его ещё нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Почта для подтверждения регистрации и сброса пароля.
# Без SMTP_HOST письма не отправляются, а печатаются в консоль.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM='"Голос рода" <info@example.com>'

